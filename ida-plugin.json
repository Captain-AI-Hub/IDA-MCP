{
  "IDAMetadataDescriptorVersion": 1,
  "plugin": {
    "name": "IDA-MCP-Hub",
    "version": "0.9.0",
    "entryPoint": "ida_mcp.py",
    "urls": {
      "repository": "https://github.com/Captain-AI-Hub/IDA-MCP"
    },
    "description": "JSON-RPC bridge for the IDA-MCP standalone server (stdio default, http optional) with headless idalib workers.",
    "categories": [
      "disassembly-and-processor-modules",
      "decompilation",
      "debugging-and-tracing",
      "api-scripting-and-automation"
    ],
    "keywords": [
      "mcp",
      "automation",
      "reverse-engineering",
      "debugging"
    ],
    "license": "GPL-3.0-only",
    "authors": [
      {
        "name": "Jelasin",
        "email": "97788570+jelasin@users.noreply.github.com"
      }
    ],
    "idaVersions": ">=9.0",
    "pythonDependencies": [],
    "settings": [
      {
        "key": "ida_path",
        "type": "string",
        "required": false,
        "default": "",
        "name": "IDA executable path",
        "documentation": "Optional full path to ida.exe (Windows) or ida. Needed by GUI launches (open_database with headless=gui).",
        "prompt": true
      },
      {
        "key": "ida_python",
        "type": "string",
        "required": false,
        "default": "auto",
        "name": "IDAPython interpreter path",
        "documentation": "Python executable used by this IDA installation; auto resolves it from the running IDA process on first launch.",
        "prompt": true
      },
      {
        "key": "idalib_python",
        "type": "string",
        "required": false,
        "default": "",
        "name": "idalib Python (headless workers)",
        "documentation": "Python with the official idalib bindings activated (idapro importable). Used by headless open_database workers; auto-detected from ida_python when empty.",
        "prompt": true
      },
      {
        "key": "request_timeout",
        "type": "string",
        "required": false,
        "default": "30",
        "name": "Request timeout",
        "documentation": "Tool request timeout in seconds.",
        "validation_pattern": "[0-9]+",
        "prompt": false
      },
      {
        "key": "debug",
        "type": "boolean",
        "required": false,
        "default": false,
        "name": "Debug logging",
        "documentation": "Enable verbose IDA-MCP diagnostic logging.",
        "prompt": true
      }
    ]
  }
}
